set -o pipefail


_backup_at_scripts_launcher.sh()
{
	local cur OPTS prev
	local scriptloc=@pkglibexecdir@
	readonly scriptloc

	COMPREPLY=()
	cur="${COMP_WORDS[COMP_CWORD]}"
	prev="${COMP_WORDS[COMP_CWORD-1]}"

	OPTS="-h -t -V"
	OPTS+=" --help --timespec --version"
	if [[ ${prev} == "backup-at-scripts-launcher.sh" ]]; then
		# shellcheck disable=SC2207  # This is _the_ bash completion
		# pattern, so leave it be.
		COMPREPLY=( $(compgen -W "${OPTS[*]}" -- "${cur}") )
	else
		local IFS=$'\n'
		compopt -o filenames
		# shellcheck disable=SC2207  # This is _the_ bash completion
		# pattern, so leave it be.
		COMPREPLY=( $(compgen -f "$scriptloc" -- "${cur}") )
	fi

	return 0
}
complete -F _backup_at_scripts_launcher.sh backup-at-scripts-launcher.sh

